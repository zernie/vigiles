{
  "name": "vigiles",
  "version": "0.0.0-semantically-released",
  "type": "module",
  "description": "Audit, test and measure the harness your AI agent runs on — grade your CLAUDE.md / AGENTS.md, skills, subagents and hooks, run them against a scripted model, and measure whether they actually fire.",
  "keywords": [
    "claude-code",
    "codex",
    "agents",
    "agentic",
    "ai",
    "llm",
    "harness",
    "hooks",
    "skills",
    "claude",
    "agents-md",
    "eval",
    "testing",
    "linter"
  ],
  "homepage": "https://github.com/zernie/vigiles#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zernie/vigiles.git"
  },
  "bugs": {
    "url": "https://github.com/zernie/vigiles/issues"
  },
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "report",
    "site"
  ],
  "bin": {
    "vigiles": "dist/cli.js"
  },
  "main": "./dist/entries/index.js",
  "types": "./dist/entries/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/entries/index.d.ts",
      "import": "./dist/entries/index.js",
      "require": "./dist/cjs/entries/index.cjs"
    },
    "./spec": {
      "types": "./dist/entries/spec.d.ts",
      "import": "./dist/entries/spec.js",
      "require": "./dist/cjs/entries/spec.cjs"
    },
    "./eval": {
      "types": "./dist/entries/eval.d.ts",
      "import": "./dist/entries/eval.js",
      "require": "./dist/cjs/entries/eval.cjs"
    },
    "./rule-proof": {
      "types": "./dist/entries/rule-proof.d.ts",
      "import": "./dist/entries/rule-proof.js",
      "require": "./dist/cjs/entries/rule-proof.cjs"
    },
    "./hook": {
      "types": "./dist/entries/hook.d.ts",
      "import": "./dist/entries/hook.js",
      "require": "./dist/cjs/entries/hook.cjs"
    },
    "./hook/testing": {
      "types": "./dist/entries/hook/testing.d.ts",
      "import": "./dist/entries/hook/testing.js",
      "require": "./dist/cjs/entries/hook/testing.cjs"
    },
    "./fixtures": {
      "types": "./dist/entries/fixtures.d.ts",
      "import": "./dist/entries/fixtures.js",
      "require": "./dist/cjs/entries/fixtures.cjs"
    },
    "./harness/claude-code": {
      "types": "./dist/entries/harness/claude-code.d.ts",
      "import": "./dist/entries/harness/claude-code.js",
      "require": "./dist/cjs/entries/harness/claude-code.cjs"
    },
    "./harness/codex": {
      "types": "./dist/entries/harness/codex.d.ts",
      "import": "./dist/entries/harness/codex.js",
      "require": "./dist/cjs/entries/harness/codex.cjs"
    },
    "./harness/kit": {
      "types": "./dist/entries/harness/kit.d.ts",
      "import": "./dist/entries/harness/kit.js",
      "require": "./dist/cjs/entries/harness/kit.cjs"
    },
    "./vitest": {
      "types": "./dist/vitest.d.mts",
      "default": "./dist/vitest.mjs"
    },
    "./jest": {
      "types": "./dist/jest.d.ts",
      "import": "./dist/jest.js",
      "require": "./dist/cjs/jest.cjs"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.mjs",
    "dist/**/*.cjs",
    "dist/**/*.d.ts",
    "dist/**/*.d.mts",
    "dist/audit-report.template.html",
    "dist/vigilesrc.schema.json",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "action.yml",
    "plugin.json",
    ".claude-plugin",
    "hooks",
    "skills",
    "!skills/**/*.spec.ts",
    "packages/eslint-config/index.mjs",
    "packages/eslint-config/README.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && node scripts/build-cjs.mjs && node scripts/build-config-schema.mjs && node scripts/build-report.mjs",
    "build:core": "tsc",
    "test": "npm run build && vitest run",
    "coverage": "npm run build && vitest run --coverage",
    "lint": "eslint src/ packages/report-view/src",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "test:unit": "npm run build && vitest run --project unit",
    "test:integration": "npm run build && vitest run --project integration",
    "test:e2e": "npm run build && vitest run --project e2e",
    "test:harness": "npm run build && node dist/cli.js test",
    "test:eval": "npm run build && node dist/cli.js eval --all",
    "test:vitest": "npm run build && vitest run --project runners",
    "test:jest": "npm run build && jest",
    "test:node-runner": "npm run build && node --test test/runners/checks.node-test.mjs",
    "test:types": "npm run build && tsc --noEmit -p test/types/tsconfig.json",
    "api:report": "npm run build && node scripts/api-extractor.mjs --local",
    "api:check": "npm run build && node scripts/api-extractor.mjs",
    "check": "node scripts/check.mjs",
    "docs:check": "npm run build && node scripts/check-doc-imports.mjs . docs README.md",
    "exports:check": "npm run build && node scripts/check-export-prefixes.mjs .",
    "internal:check": "npm run api:check && node scripts/check-internal-tag.mjs",
    "docs:api": "typedoc"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@jackchuka/mdschema": "^0.12.8",
    "@microsoft/api-extractor": "^7.58.9",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/markdown-it": "^14.1.2",
    "@types/minimatch": "^5.1.2",
    "@types/node": "^20.19.39",
    "@types/picomatch": "^4.0.2",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "@vitest/coverage-v8": "^4.1.8",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "esbuild": "^0.27.7",
    "eslint": "^10.1.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-functional": "^10.0.1",
    "eslint-plugin-sonarjs": "^4.0.2",
    "globals": "^17.4.0",
    "jest": "^30.4.2",
    "picomatch": "^4.0.4",
    "prettier": "^3.8.1",
    "semantic-release": "25.0.9",
    "tsx": "^4.21.0",
    "typedoc": "^0.28.19",
    "typescript": "^7.0.2",
    "vitest": "^4.1.8"
  },
  "peerDependencies": {
    "jest": ">=28",
    "vitest": ">=1"
  },
  "peerDependenciesMeta": {
    "jest": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "dependencies": {
    "@ast-grep/napi": "^0.51.3",
    "@iarna/toml": "^2.2.5",
    "@vscode/tree-sitter-wasm": "0.3.1",
    "ci-info": "^4.4.0",
    "cosmiconfig": "^10.0.1",
    "effect": "^4.1.5",
    "glob": "^14.0.6",
    "js-yaml": "^5.5.0",
    "markdown-it": "^15.0.3",
    "minimatch": "^11.0.9",
    "mvdan-sh": "^0.10.1",
    "remeda": "^2.62.2",
    "ts-essentials": "^10.2.1",
    "typescript": "^7.0.2",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
