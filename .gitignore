node_modules
dist/
coverage/
.DS_Store
logo-v*.png
.idea

# Python bytecode cache — produced by running a vendored *.py dogfood fixture
# (e.g. gen-trailofbits-expected.mjs's runScript calls against
# test/dogfood/trailofbits-skills-curated@*/plugins/last30days/scripts/lib/dates.py)
__pycache__/
*.pyc

# oh-my-claudecode transient session state (never committed)
.omc/

# vigiles transient skill-runtime state
.vigiles/active-skill.json
# observability flight-recorder ledger (local runtime record, never committed)
.vigiles/runs.jsonl
# eval record/replay cache (recorded model runs)
.vigiles/eval-cache/
# runtime-owned named state for compiled hooks (`record()`/`state()`). Local to
# THIS checkout: it records when a hook last spoke here, so committing it would
# silence a teammate's hook for a window they never saw. Absent = every fact
# reads as never-recorded, so a throttled hook SPEAKS — the safe direction, by
# construction (see the `Infinity` note in src/core/hook-state.ts).
.vigiles/state/
# what a LOCAL run exercised (the execution tier of test coverage). Never
# committed: it describes THIS checkout at THIS moment, and a committed one would
# credit coverage on a machine where nothing ran — the substitution it exists to
# stop. Absent = coverage falls back to colocation, exactly as before it existed.
.vigiles/coverage.json

# API Extractor temp output (the committed contract is api-surface/*.api.md) + the
# API Documenter reference site (a derived artifact — `npm run docs:api`).
temp/
api-reference/

# npm pack artifacts (smoke tests)
*.tgz

# Generated audit report
vigiles-report.html
vigiles-report.json
report/dist

# transient test scratch dirs (generate-harness / type-check / vigiles test)
.tmp-genh-*/
.tmp-compile-genh-*/
.vigiles-test-types-tmp/

# session scratch (OSS dogfood corpus, repro scripts)
scratchpad/

# local screenshot scratch (screenshot skill output)
scratch-shots/

# subagent isolated worktrees (transient, never committed)
.claude/worktrees/

# Design and strategy notes are NOT kept in this repository
research/

# Raw output of examples/experimental-emit/run-emit.mjs. A run replays a real
# skill from the operator's own corpus, so these carry un-redacted model prose
# about a private harness; the committed records under records/*-2026-08-13.jsonl
# are the redacted, publishable extraction.
examples/experimental-emit/records/emits.jsonl
examples/experimental-emit/records/emitted.jsonl
examples/experimental-emit/records/records-emit.jsonl
