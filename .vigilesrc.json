{
  "rules": {
    "require-instructions-spec": "error",
    "integrity": "warn",
    "coverage": [
      "warn",
      {
        "scripts": 50,
        "linterRules": 5
      }
    ],
    "subagent-tool-contract": "error",
    "subagent-frontmatter": "error",
    "hook-events": "error",
    "hook-script-exists": "error",
    "hand-written-hook": "warn",
    "mcp-config": "error",
    "mcp-tool-resolves": "error",
    "mcp-hook-target-resolves": "error",
    "disallowed-tools-contract": "error",
    "description-overlap": "error",
    "compile-budget": "error",
    "untested-skill": [
      "warn",
      {
        "include": [
          "**/*.harness.{ts,mts,cts,js,mjs,cjs}",
          "**/*.eval.{ts,mts,cts,js,mjs,cjs}",
          "examples/harness/dogfood/{surface}.trigger.eval.mjs",
          "src/{surface}.test.ts"
        ]
      }
    ],
    "untested-hook": [
      "warn",
      {
        "include": [
          "**/*.harness.{ts,mts,cts,js,mjs,cjs}",
          "**/*.eval.{ts,mts,cts,js,mjs,cjs}",
          "examples/harness/dogfood/{surface}.trigger.eval.mjs",
          "src/{surface}.test.ts"
        ]
      }
    ]
  },
  "orphans": {
    "include": ["docs/**/*.md"]
  },
  "exclude": [
    ".claude/worktrees/**",
    "bench/**",
    "startup/**",
    "rule-enforcer/**",
    "test/fixtures/instruction-chain-vendor/**",
    "test/dogfood/trailofbits-skills-curated@6d05be4/CLAUDE.md"
  ]
}
