{
  "name": "@vigiles/site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "The vigiles marketing landing page — Vite + React + Tailwind v4 + shadcn-style components, built to static output for GitHub Pages. A separate package (like @vigiles/report) so its frontend toolchain never enters the published CLI's runtime deps.",
  "scripts": {
    "gen:checks": "tsx scripts/gen-check-pages.ts",
    "prebuild": "tsx scripts/gen-check-pages.ts",
    "build": "vite build",
    "predev": "tsx scripts/gen-check-pages.ts",
    "dev": "vite",
    "preview": "vite preview",
    "test:browser": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "gen:parity": "node scripts/gen-parity-expected.mjs",
    "gen:og": "node scripts/gen-og.mjs",
    "gen:battery": "node scripts/gen-battery-expected.mjs",
    "pretest:browser": "node scripts/gen-battery-expected.mjs && node scripts/gen-davila7-expected.mjs",
    "gen:davila7": "node scripts/gen-davila7-expected.mjs"
  },
  "dependencies": {
    "@vigiles/report-view": "*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^0.469.0",
    "pako": "^2.2.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/pako": "^2.0.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/browser": "^4.1.8",
    "@vitest/browser-playwright": "^4.1.8",
    "playwright": "^1.61.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.8"
  }
}
